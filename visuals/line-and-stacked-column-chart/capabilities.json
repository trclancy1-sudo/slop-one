        {
            "conditions": [
                {
                    "category": { "max": 1 },
                    "columnValues": { "min": 0 },
                    "lineValues": { "min": 0 }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "category"
                    },
                    "dataReductionAlgorithm": {
                        "top": { "count": 1000 }
                    }
                },
                "values": {
                    "select": [
                        {
