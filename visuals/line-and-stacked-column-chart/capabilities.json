{
    "dataRoles": [
        {
            "displayName": "Axis",
            "name": "category",
            "kind": "Grouping",
            "description": "The categorical axis (e.g. months, regions)"
        },
        {
            "displayName": "Column Legend",
            "name": "columnLegend",
            "kind": "Grouping",
            "description": "Categorical field to split columns into series (e.g. product, region)"
        },
        {
            "displayName": "Column Values",
            "name": "columnValues",
            "kind": "Measure",
            "description": "Measures displayed as stacked columns"
        },
        {
            "displayName": "Line Values",
            "name": "lineValues",
            "kind": "Measure",
            "description": "Measures displayed as lines"
        },
        {
            "displayName": "Tooltips",
            "name": "tooltips",
            "kind": "Measure",
            "description": "Extra measures shown only in tooltips"
        }
    ],
    "objects": {
        "animation": {
            "properties": {
                "entranceStyle": {
                    "type": {
                        "enumeration": [
                            { "value": "growUp", "displayName": "Grow Up" },
                            { "value": "fadeIn", "displayName": "Fade In" },
                            { "value": "spring", "displayName": "Spring" },
                            { "value": "none", "displayName": "None" }
                        ]
                    }
                },
                "crossFilterStyle": {
                    "type": {
                        "enumeration": [
                            { "value": "spring", "displayName": "Spring" },
                            { "value": "growUp", "displayName": "Grow Up" },
                            { "value": "fadeIn", "displayName": "Fade In" },
                            { "value": "none", "displayName": "None" }
                        ]
                    }
                },
                "duration": {
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "fontSettings": {
            "properties": {
                "fontFamily": {
                    "type": {
                        "enumeration": [
                            { "value": "Segoe UI", "displayName": "Segoe UI" },
                            { "value": "Arial", "displayName": "Arial" },
                            { "value": "Calibri", "displayName": "Calibri" },
                            { "value": "Verdana", "displayName": "Verdana" },
                            { "value": "Tahoma", "displayName": "Tahoma" },
                            { "value": "Trebuchet MS", "displayName": "Trebuchet MS" },
                            { "value": "Georgia", "displayName": "Georgia" },
                            { "value": "Times New Roman", "displayName": "Times New Roman" },
                            { "value": "Courier New", "displayName": "Courier New" },
                            { "value": "DIN", "displayName": "DIN" },
                            { "value": "wf_standard-font", "displayName": "Power BI Standard" }
                        ]
                    }
                }
            }
        },
        "colorSelector": {
            "properties": {
                "fill": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "columnSettings": {
            "properties": {
                "fill": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "borderColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "borderWidth": {
                    "type": {
                        "numeric": true
                    }
                },
                "cornerRadius": {
                    "type": {
                        "numeric": true
                    }
                },
                "showDataLabels": {
                    "type": {
                        "bool": true
                    }
                },
                "dataLabelFontSize": {
                    "type": {
                        "numeric": true
                    }
                },
                "dataLabelColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "lineSettings": {
            "properties": {
                "fill": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "strokeWidth": {
                    "type": {
                        "numeric": true
                    }
                },
                "showMarkers": {
                    "type": {
                        "bool": true
                    }
                },
                "markerSize": {
                    "type": {
                        "numeric": true
                    }
                },
                "showDataLabels": {
                    "type": {
                        "bool": true
                    }
                },
                "dataLabelFontSize": {
                    "type": {
                        "numeric": true
                    }
                },
                "dataLabelColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "lineStyle": {
                    "type": {
                        "enumeration": [
                            { "value": "solid", "displayName": "Solid" },
                            { "value": "dashed", "displayName": "Dashed" },
                            { "value": "dotted", "displayName": "Dotted" }
                        ]
                    }
                }
            }
        },
        "legend": {
            "properties": {
                "show": {
                    "type": {
                        "bool": true
                    }
                },
                "position": {
                    "type": {
                        "enumeration": [
                            { "value": "bottom", "displayName": "Bottom" },
                            { "value": "top", "displayName": "Top" },
                            { "value": "left", "displayName": "Left" },
                            { "value": "right", "displayName": "Right" }
                        ]
                    }
                },
                "fontSize": {
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                },
                "fontColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "gridlines": {
            "properties": {
                "showHorizontal": {
                    "type": {
                        "bool": true
                    }
                },
                "showVertical": {
                    "type": {
                        "bool": true
                    }
                },
                "color": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "strokeWidth": {
                    "type": {
                        "numeric": true
                    }
                },
                "lineStyle": {
                    "type": {
                        "enumeration": [
                            { "value": "solid", "displayName": "Solid" },
                            { "value": "dashed", "displayName": "Dashed" },
                            { "value": "dotted", "displayName": "Dotted" }
                        ]
                    }
                }
            }
        },
        "xAxis": {
            "properties": {
                "show": {
                    "type": {
                        "bool": true
                    }
                },
                "fontSize": {
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                },
                "fontColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "title": {
                    "type": {
                        "text": true
                    }
                },
                "maxWidth": {
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "yAxis": {
            "properties": {
                "show": {
                    "type": {
                        "bool": true
                    }
                },
                "fontSize": {
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                },
                "fontColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "leftTitle": {
                    "type": {
                        "text": true
                    }
                },
                "rightTitle": {
                    "type": {
                        "text": true
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": { "max": 1 },
                    "columnLegend": { "max": 1 },
                    "columnValues": { "min": 0 },
                    "lineValues": { "min": 0 },
                    "tooltips": { "min": 0 }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "category"
                    },
                    "dataReductionAlgorithm": {
                        "top": { "count": 1000 }
                    }
                },
                "values": {
                    "group": {
                        "by": "columnLegend",
                        "select": [
                            {
                                "for": {
                                    "in": "columnValues"
                                }
                            },
                            {
                                "for": {
                                    "in": "lineValues"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ]
                    }
                }
            }
        }
    ],
    "privileges": []
}
