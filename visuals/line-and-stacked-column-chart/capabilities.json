{
    "dataRoles": [
        {
            "displayName": "Axis",
            "name": "category",
            "kind": "Grouping",
            "description": "The categorical axis (e.g. months, regions)"
        },
        {
            "displayName": "Column Values",
            "name": "columnValues",
            "kind": "Measure",
            "description": "Measures displayed as stacked columns"
        },
        {
            "displayName": "Line Values",
            "name": "lineValues",
            "kind": "Measure",
            "description": "Measures displayed as lines"
        }
    ],
    "objects": {
        "columnSettings": {
            "properties": {
                "fill": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "lineSettings": {
            "properties": {
                "fill": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "strokeWidth": {
                    "type": {
                        "numeric": true
                    }
                },
                "showMarkers": {
                    "type": {
                        "bool": true
                    }
                }
            }
        },
        "legend": {
            "properties": {
                "show": {
                    "type": {
                        "bool": true
                    }
                },
                "fontSize": {
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                }
            }
        },
        "xAxis": {
            "properties": {
                "show": {
                    "type": {
                        "bool": true
                    }
                },
                "fontSize": {
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                }
            }
        },
        "yAxis": {
            "properties": {
                "show": {
                    "type": {
                        "bool": true
                    }
                },
                "fontSize": {
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": { "max": 1 },
                    "columnValues": { "min": 0 },
                    "lineValues": { "min": 0 }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "category"
                    },
                    "dataReductionAlgorithm": {
                        "top": { "count": 1000 }
                    }
                },
                "values": {
                    "select": [
                        {
                            "for": {
                                "in": "columnValues"
                            }
                        },
                        {
                            "for": {
                                "in": "lineValues"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "privileges": []
}
